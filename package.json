{
  "name": "uneven-app",
  "description": "Web app that lets you track shared expenses, using React/Redux and PouchDB/CouchDB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xMartin/grouptabs.git"
  },
  "author": "xMartin <xmartin@siarp.de>",
  "bugs": {
    "url": "https://github.com/xMartin/grouptabs/issues"
  },
  "homepage": "https://getuneven.com/",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "yarn": "1.x"
  },
  "scripts": {
    "postinstall": "husky",
    "dev": "VITE_APP_VERSION=${VITE_APP_VERSION:-`git describe HEAD`} vite",
    "build": "tsc && VITE_APP_VERSION=${VITE_APP_VERSION:-`git describe HEAD`} vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "VITE_APP_VERSION=${VITE_APP_VERSION:-`git describe HEAD`} vite preview",
    "test": "LC_ALL=en_US TZ=Europe/Berlin vitest",
    "test:ui": "LC_ALL=en_US TZ=Europe/Berlin vitest --ui",
    "type-check": "tsc"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.10.11",
    "@types/pouchdb": "^6.4.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@types/redux-first-router": "^2.1.12",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/ui": "^4.0.18",
    "debug": "^4.4.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "events": "^3.3.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "lodash": "^4.17.23",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-browser": "^9.0.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-test-renderer": "^19.2.4",
    "redux": "^5.0.1",
    "redux-first-router": "^2.1.5",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.1.1",
    "typescript": "^5.5.3",
    "uuid": "^13.0.0",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  },
  "license": "GPL-3.0",
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ],
    "README.md": [
      "prettier --write"
    ],
    "release-notes.yml": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "vite": "^8.0.1"
  }
}
